{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node"],
    // only here so the shadcn CLI can resolve @/ when run from the repo root
    "paths": { "@/*": ["./web/src/*"] }
  },
  "include": [
    "server/**/*.ts",
    "shared/**/*.ts"
  ]
}
