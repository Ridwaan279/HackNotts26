# HOST=0.0.0.0 so the phone can reach it on the same wifi
HOST=127.0.0.1
PORT=3000
# hermes api server, the key is API_SERVER_KEY in ~/.hermes/.env
HERMES_URL=http://127.0.0.1:8642/v1
HERMES_KEY=
# voice replies, leave the key empty to turn voice off
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# mkcert files, the phone only allows the mic over https (see README)
TLS_CERT=
TLS_KEY=
