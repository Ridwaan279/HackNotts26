# HOST=0.0.0.0 so the phone can reach it on the same wifi
HOST=127.0.0.1
PORT=3000
# the model runs on the laptop, the pi is too slow: http://<laptop-ip>:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_MS=120000
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=256
DB_PATH=./data/pet.sqlite
# voice replies, leave the key empty to turn voice off
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# mkcert files, the phone only allows the mic over https (see README)
TLS_CERT=
TLS_KEY=
# hermes agent as the brain (see data/docs/hermes.md), leave HERMES_URL empty to talk to ollama directly
HERMES_URL=
HERMES_KEY=
HERMES_SESSION=byte
HERMES_TIMEOUT_MS=300000
