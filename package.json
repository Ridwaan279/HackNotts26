{
  "name": "hacknotts26-wrist-pet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "build": "npm run typecheck && tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "start": "node --env-file-if-exists=.env dist/server/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "express": "5.3.0",
    "lucide-react": "1.61.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
